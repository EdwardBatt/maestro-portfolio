# Supabase — client-safe values only (Vite exposes VITE_* to the browser bundle).
# The publishable key (sb_publishable_...) is the public client key; RLS is the
# security boundary, never this key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side secrets are NEVER put in this file or any VITE_* variable.
# The secret key (sb_secret_...) and DB password live in the deploy platform's
# secret store / password manager only:
#   SUPABASE_SECRET_KEY=
#   B2_APPLICATION_KEY_ID=
#   B2_APPLICATION_KEY=
#   OPENAI_API_KEY=      (ingest-brief, ADR-0044 — a billable credential; an
#                            Edge Function secret only, NEVER a VITE_ variable)

# supabase/functions/.env — secrets for the local Edge Functions runtime.
#
# Copy this to `supabase/functions/.env` and fill in the real values, then run:
#   supabase functions serve --env-file supabase/functions/.env
# (The file is gitignored — it holds secrets. SUPABASE_URL / SUPABASE_ANON_KEY /
#  SUPABASE_SERVICE_ROLE_KEY are injected automatically by the local runtime, so they are
#  not needed here.)
#
# WITHOUT these, the AI and email paths return errors and the flows that depend on them dead-end:
#   - read-brief-receipt / ingest-brief  → 503 model_unconfigured   (the receipt model-read, SJ-03 brief fill)
#   - notify-email                        → cannot send             (every notification email)

# --- OpenAI (ADR-0049): the receipt model-read and brief ingestion ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna            # optional; defaults to the ADR-0049 model

# --- Email (ADR-0081): Resend, fenced by the allowlist so dev mail cannot reach real clients ---
RESEND_API_KEY=re_...
NOTIFY_EMAIL_FROM=Maestro <notifications@your-domain>
# EMAIL_ALLOWLIST — comma-separated; only these addresses receive mail. MUST stay set locally,
# and MUST stay UNSET in production. Plus-addressing aware (maestro.dev+am@example.test matches
# maestro.dev@example.test). Fails closed on an empty entry.
EMAIL_ALLOWLIST=maestro.dev@example.test

# --- Links in emails ---
APP_BASE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# --- Cron functions (archive-sweep etc.) ---
CRON_SECRET=any-long-random-string-for-local

# Where outbound mail goes. `resend` (default) sends for real through RESEND_API_KEY. `mailpit` sends
# to the local Mailpit (the CLI's, on 54324) so every notification and error report is readable at
# http://127.0.0.1:54324 and nothing leaves the machine — the setting the test plan uses
# (docs/E2E-PLAN.md). MAILPIT_URL is as seen from the Edge runtime's container, not from the host.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://host.docker.internal:54324
